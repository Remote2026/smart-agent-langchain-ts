{
  "name": "smart-agent-langchain-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsx -e \"import{rmSync}from'fs';try{rmSync('dist',{recursive:true,force:true})}catch(_){}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chat": "tsx scripts/test-chat.ts",
    "test:device-event": "tsx scripts/test-device-event.ts",
    "test:image": "tsx scripts/test-image.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.79",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/langgraph-checkpoint-sqlite": "^0.2.1",
    "@langchain/openai": "^0.6.14",
    "@slack/bolt": "^4.7.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.1",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
