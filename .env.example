# === LLM ===
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=qwen-turbo

# === SmartThings ===
# OAuth2 方式（推荐）
SMARTTHINGS_CLIENT_ID=replace-me
SMARTTHINGS_ACCESS_TOKEN=replace-me
SMARTTHINGS_REFRESH_TOKEN=replace-me
# 遗留 PAT 方式（仅在未配置 OAuth 时作为 fallback）
# SMARTTHINGS_PAT=replace-me
SMARTTHINGS_CLI_CONFIG_PATH=~/.config/@smartthings/cli/config.yaml

# === ROS2 / Foxglove ===
ROSBRIDGE_URL=ws://localhost:9090
FOXGLOVE_URL=ws://172.18.0.1:8765

# === Server ===
PORT=3000

# === Slack Socket Mode ===
SLACK_ENABLED=true
SLACK_BOT_TOKEN=replace-me
SLACK_APP_TOKEN=replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_MIRROR_WEB_MESSAGES=false
SLACK_DEFAULT_CHANNEL_ID=replace-me

# === DeepSeek Thinking Mode ===
# 仅在使用 DeepSeek V4 系列模型时设置：
# - enabled:  启用 thinking mode（返回 reasoning_content）
# - disabled: 关闭 thinking mode（避免 400 错误）
# 未设置 = 不使用 DeepSeek，不影响其他模型
# DEEPSEEK_THINKING_MODE=disabled
